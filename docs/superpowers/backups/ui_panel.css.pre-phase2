/* 材料科研副驾面板样式 —— 跟随宿主主题（CSS 变量优先） */
.mrc-panel {
  --mrc-accent: var(--hana-accent, #e08a3c);
  --mrc-accent-soft: var(--hana-accent-soft, rgba(224, 138, 60, 0.18));
  --mrc-bg: var(--hana-bg, transparent);
  --mrc-bg-card: var(--hana-bg-card, rgba(128, 128, 128, 0.06));
  --mrc-bg-solid: var(--hana-bg, #f8f5ed);
  --mrc-border: var(--hana-border, rgba(128, 128, 128, 0.25));
  --mrc-text: var(--hana-text, #2c2c2c);
  --mrc-text-dim: var(--hana-text-dim, #8a8a8a);
  --mrc-danger: #d64541;
  --mrc-ok: #2e9e5b;
}

.mrc-app {
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 13px;
  color: var(--mrc-text);
  background: var(--mrc-bg);
  min-height: 100%;
}

/* 头部 */
.mrc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  border-bottom: 1px solid var(--mrc-border);
}
.mrc-header-title { display: flex; align-items: center; gap: 8px; font-weight: 600; }
.mrc-logo { font-size: 18px; }
.mrc-binding { margin-left: 6px; }
.mrc-badge { font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 400; }
.mrc-badge.ok { background: rgba(46, 158, 91, 0.15); color: var(--mrc-ok); }
.mrc-badge.warn { background: rgba(224, 138, 60, 0.18); color: var(--mrc-accent); }
.mrc-header-actions { display: flex; gap: 6px; }

/* 按钮与输入 */
.mrc-btn {
  border: 1px solid var(--mrc-border);
  background: var(--mrc-bg-card);
  color: var(--mrc-text);
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 12px;
  cursor: pointer;
  transition: opacity 0.15s;
}
.mrc-btn:hover { opacity: 0.85; }
.mrc-btn:disabled { opacity: 0.45; cursor: not-allowed; }
.mrc-btn.primary { background: var(--mrc-accent); border-color: var(--mrc-accent); color: #fff; }
.mrc-btn.danger { color: var(--mrc-danger); border-color: rgba(214, 69, 65, 0.5); }
.mrc-btn.small { padding: 2px 8px; font-size: 11px; }

.mrc-app input, .mrc-app textarea, .mrc-app select {
  border: 1px solid var(--mrc-border);
  background: var(--mrc-bg-card);
  color: var(--mrc-text);
  border-radius: 6px;
  padding: 5px 8px;
  font-size: 12px;
  font-family: inherit;
  width: 100%;
  box-sizing: border-box;
}
.mrc-app textarea { resize: vertical; }

/* 三栏布局 */
.mrc-grid {
  display: grid;
  grid-template-columns: 1fr 1.15fr 1.25fr;
  gap: 10px;
  padding: 0 10px 10px;
  align-items: start;
}
@media (max-width: 1100px) {
  .mrc-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 760px) {
  .mrc-grid { grid-template-columns: 1fr; }
  .mrc-header { flex-wrap: wrap; }
  .mrc-literature-list { max-height: 200px; }
  .mrc-list, .mrc-tasklist { max-height: 200px; }
  .mrc-proposals { max-height: 240px; }
  .mrc-field textarea { min-height: 56px; }
}
/* 侧边栏 widget（~300px 窄容器）：精简为文献速览 + 方案编辑，隐藏时间线大块 */
body[data-surface="widget"] .mrc-col-right { display: none; }
body[data-surface="widget"] .mrc-col-left .mrc-report-block { display: none; }
body[data-surface="widget"] .mrc-literature-list { max-height: 140px; }
body[data-surface="widget"] .mrc-field textarea { min-height: 48px; }
body[data-surface="widget"] .mrc-header-actions { display: none; }
.mrc-col { min-width: 0; }
.mrc-panel-section {
  background: var(--mrc-bg-card);
  border: 1px solid var(--mrc-border);
  border-radius: 10px;
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  overflow: hidden;
}

/* 区块头 */
.mrc-section-head { display: flex; align-items: center; gap: 8px; }
.mrc-section-title { font-weight: 600; font-size: 13px; }
.mrc-count { background: var(--mrc-accent-soft); color: var(--mrc-accent); border-radius: 10px; padding: 1px 8px; font-size: 11px; }
.mrc-zotero-status { margin-left: auto; font-size: 11px; color: var(--mrc-text-dim); }

/* 筛选 chips */
.mrc-filter-row { display: flex; gap: 4px; flex-wrap: wrap; }
.mrc-chip {
  border: 1px solid var(--mrc-border);
  background: transparent;
  color: var(--mrc-text);
  border-radius: 12px;
  padding: 2px 10px;
  font-size: 11px;
  cursor: pointer;
}
.mrc-chip.active { background: var(--mrc-accent); border-color: var(--mrc-accent); color: #fff; }
.mrc-chip.mini { font-size: 10px; padding: 1px 7px; }
.mrc-chip.mini.target-plan { border-color: rgba(78, 121, 167, 0.5); color: #4e79a7; }
.mrc-chip.mini.target-gantt { border-color: rgba(224, 138, 60, 0.5); color: var(--mrc-accent); }
.mrc-chip.mini.target-worklog { border-color: rgba(46, 158, 91, 0.5); color: var(--mrc-ok); }
.mrc-chip.mini.target-literature { border-color: rgba(155, 93, 229, 0.5); color: #9b5de5; }

/* 文献列表 */
.mrc-literature-list { display: flex; flex-direction: column; gap: 6px; max-height: 560px; overflow-y: auto; }
.mrc-paper-card {
  border: 1px solid var(--mrc-border);
  border-radius: 8px;
  padding: 8px;
  background: var(--mrc-bg);
}
.mrc-paper-title { font-weight: 600; font-size: 12.5px; line-height: 1.35; }
.mrc-paper-meta { display: flex; gap: 8px; align-items: center; margin-top: 3px; font-size: 11px; color: var(--mrc-text-dim); flex-wrap: wrap; }
.mrc-paper-year { color: var(--mrc-accent); }
.mrc-paper-venue { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 160px; }
.mrc-paper-source { font-size: 10px; padding: 1px 6px; border-radius: 8px; }
.mrc-paper-source.src-online { background: rgba(78, 121, 167, 0.15); color: #4e79a7; }
.mrc-paper-source.src-workspace { background: rgba(46, 158, 91, 0.15); color: var(--mrc-ok); }
.mrc-paper-source.src-zotero { background: rgba(214, 69, 65, 0.12); color: var(--mrc-danger); }
.mrc-paper-cites { font-size: 10px; }
.mrc-paper-authors { font-size: 11px; color: var(--mrc-text-dim); margin-top: 2px; }
.mrc-paper-abstract { font-size: 11.5px; color: var(--mrc-text-dim); margin: 4px 0 0; line-height: 1.4; }
.mrc-paper-links { display: flex; gap: 10px; margin-top: 4px; font-size: 11px; }
.mrc-paper-doi { color: var(--mrc-text-dim); }
.mrc-paper-links a { color: var(--mrc-accent); text-decoration: none; }

/* 报告 */
.mrc-report-block { border-top: 1px dashed var(--mrc-border); padding-top: 8px; display: flex; flex-direction: column; gap: 6px; }
.mrc-report-time { font-size: 11px; color: var(--mrc-text-dim); }
.mrc-report-body {
  font-size: 12px; line-height: 1.55;
  max-height: 420px; overflow-y: auto;
  border: 1px solid var(--mrc-border);
  border-radius: 8px;
  padding: 8px;
  white-space: pre-wrap;
  word-break: break-word;
}

/* Tabs */
.mrc-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--mrc-border); padding-bottom: 6px; }
.mrc-tab {
  border: none; background: transparent; color: var(--mrc-text-dim);
  padding: 5px 10px; border-radius: 6px; font-size: 12.5px; cursor: pointer;
}
.mrc-tab.active { background: var(--mrc-accent-soft); color: var(--mrc-accent); font-weight: 600; }
.mrc-tab.has-badge { color: var(--mrc-danger); font-weight: 700; }

/* 方案编辑器 */
.mrc-plan-editor, .mrc-worklog { display: flex; flex-direction: column; gap: 8px; }
.mrc-field { display: flex; flex-direction: column; gap: 4px; }
.mrc-field label { font-size: 11.5px; color: var(--mrc-text-dim); }
.mrc-field-row { display: flex; gap: 6px; }
.mrc-field-row input, .mrc-field-row select { width: auto; flex: 1; }
.mrc-actions { display: flex; gap: 6px; }
.mrc-hint { font-size: 11px; color: var(--mrc-text-dim); }

/* 实验记录 */
.mrc-list { display: flex; flex-direction: column; gap: 6px; max-height: 480px; overflow-y: auto; }
.mrc-log-entry { border: 1px solid var(--mrc-border); border-radius: 8px; padding: 8px; }
.mrc-log-head { display: flex; gap: 8px; font-size: 11px; color: var(--mrc-text-dim); }
.mrc-log-date { color: var(--mrc-accent); }
.mrc-log-content { margin-top: 4px; font-size: 12.5px; line-height: 1.5; }
.mrc-log-fields { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 6px; font-size: 11px; color: var(--mrc-text-dim); }
.mrc-log-field b { color: var(--mrc-text); font-weight: 600; }
.mrc-log-citations { margin-top: 4px; font-size: 11px; color: var(--mrc-accent); }
.mrc-log-data {
  margin: 6px 0 0; padding: 6px; background: var(--mrc-bg);
  border-radius: 6px; font-size: 11px; white-space: pre-wrap;
  max-height: 140px; overflow-y: auto;
}

/* 提案 */
.mrc-proposals { display: flex; flex-direction: column; gap: 8px; max-height: 620px; overflow-y: auto; }
.mrc-proposal { border: 1px solid var(--mrc-border); border-radius: 8px; padding: 8px; }
.mrc-proposal-head { display: flex; gap: 6px; align-items: center; }
.mrc-proposal-id { font-size: 10px; color: var(--mrc-text-dim); margin-left: auto; }
.mrc-proposal-reason { font-size: 12px; margin-top: 6px; }
.mrc-proposal-diff {
  background: var(--mrc-bg); border: 1px solid var(--mrc-border);
  border-radius: 6px; padding: 6px; font-size: 11px;
  max-height: 180px; overflow: auto; white-space: pre-wrap;
}
.mrc-proposal-edit textarea { margin-bottom: 6px; }
.mrc-proposal-reject input { margin-bottom: 6px; }

/* 悬浮提案提示 */
.mrc-proposal-float {
  position: fixed; bottom: 20px; right: 20px;
  background: var(--mrc-accent); color: #fff;
  padding: 8px 14px; border-radius: 18px; font-size: 12.5px;
  cursor: pointer; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  z-index: 60;
}

/* 甘特图 */
.mrc-gantt-wrap { display: flex; flex-direction: column; gap: 6px; }
.mrc-gantt { overflow-x: auto; }
.mrc-gantt-svg { display: block; }
.mrc-gantt-label { user-select: none; }
.mrc-gantt-edit {
  display: flex; gap: 6px; align-items: center; flex-wrap: wrap;
  border: 1px solid var(--mrc-border); border-radius: 8px; padding: 8px; margin-top: 6px;
}
.mrc-gantt-edit input, .mrc-gantt-edit select { width: auto; }

/* 任务清单（常驻独立卡片） */
.mrc-tasklist-block {
  border-top: 1px dashed var(--mrc-border);
  margin-top: 8px; padding-top: 8px;
  display: flex; flex-direction: column; gap: 6px;
}
.mrc-tasklist { display: flex; flex-direction: column; gap: 6px; max-height: 240px; overflow-y: auto; }
.mrc-task-row {
  display: flex; gap: 8px; align-items: center;
  border: 1px solid var(--mrc-border); border-radius: 6px; padding: 5px 8px;
}
.mrc-task-name { flex: 1; }
.mrc-task-name.done { text-decoration: line-through; color: var(--mrc-text-dim); }
.mrc-task-date { font-size: 11px; color: var(--mrc-text-dim); }
.mrc-task-progress { font-size: 11px; color: var(--mrc-accent); min-width: 34px; text-align: right; }

/* 日历 */
.mrc-calendar { display: flex; flex-direction: column; gap: 6px; }
.mrc-calendar-head { display: flex; gap: 6px; align-items: center; }
.mrc-calendar-title { flex: 1; text-align: center; font-weight: 600; font-size: 13px; }
.mrc-calendar-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); }
.mrc-cal-weekday { text-align: center; font-size: 11px; color: var(--mrc-text-dim); padding: 2px 0; }
.mrc-calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
.mrc-cal-cell {
  border: 1px solid var(--mrc-border); border-radius: 5px;
  min-height: 56px; padding: 2px; cursor: pointer; position: relative;
  background: var(--mrc-bg); overflow: hidden;
}
.mrc-cal-cell.muted { opacity: 0.4; }
.mrc-cal-cell.today { border-color: var(--mrc-accent); }
.mrc-cal-daynum { font-size: 10.5px; color: var(--mrc-text-dim); }
.mrc-cal-cell.today .mrc-cal-daynum { color: var(--mrc-accent); font-weight: 700; }
.mrc-cal-event {
  font-size: 9.5px; line-height: 1.25;
  background: var(--mrc-accent-soft); color: var(--mrc-text);
  border-radius: 3px; padding: 1px 3px; margin-top: 1px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  display: flex; justify-content: space-between; gap: 2px;
}
.mrc-cal-event.type-task { background: rgba(78, 121, 167, 0.2); }
.mrc-cal-del { border: none; background: transparent; color: var(--mrc-text-dim); cursor: pointer; padding: 0 2px; font-size: 10px; }
.mrc-cal-more { font-size: 9.5px; color: var(--mrc-text-dim); }
.mrc-cal-add { position: absolute; inset: 0; background: var(--mrc-bg-card); padding: 4px; z-index: 10; display: flex; flex-direction: column; gap: 4px; }
.mrc-cal-add-row { display: flex; gap: 3px; align-items: center; }
.mrc-cal-add-row input, .mrc-cal-add-row select { width: auto; flex: 1; font-size: 10px; padding: 2px 4px; }

/* 空态与加载 */
.mrc-empty { color: var(--mrc-text-dim); font-size: 12px; padding: 12px 4px; text-align: center; }
.mrc-loading { padding: 40px; text-align: center; color: var(--mrc-text-dim); }
.mrc-error { padding: 10px; color: var(--mrc-danger); display: flex; gap: 8px; align-items: center; }

/* 设置抽屉 */
.mrc-drawer-mask {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.35);
  z-index: 50; display: flex; justify-content: flex-end;
}
.mrc-drawer {
  width: min(420px, 92vw); height: 100%;
  background: var(--mrc-bg-solid);
  border-left: 1px solid var(--mrc-border);
  padding: 14px; overflow-y: auto;
  display: flex; flex-direction: column; gap: 12px;
}
.mrc-drawer-head { display: flex; justify-content: space-between; align-items: center; font-weight: 600; }
.mrc-drawer-section { display: flex; flex-direction: column; gap: 8px; }
.mrc-drawer-section h4 { margin: 0; font-size: 13px; }
.mrc-drawer-hint { font-size: 11px; color: var(--mrc-text-dim); margin: 0; line-height: 1.5; }
.mrc-folder-row {
  display: flex; justify-content: space-between; align-items: center; gap: 8px;
  border: 1px solid var(--mrc-border); border-radius: 6px; padding: 6px 8px; font-size: 12px;
}
.mrc-rejected-row { border: 1px solid var(--mrc-border); border-radius: 6px; padding: 6px 8px; }
.mrc-rejected-summary { font-size: 11.5px; }
.mrc-rejected-reason { font-size: 11px; color: var(--mrc-text-dim); margin-top: 2px; }

/* Toast */
.mrc-toast {
  position: fixed; bottom: 60px; left: 50%; transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.78); color: #fff;
  padding: 8px 16px; border-radius: 8px; font-size: 12.5px; z-index: 80;
  max-width: 70vw; animation: mrc-fadein 0.2s ease;
}
@keyframes mrc-fadein { from { opacity: 0; transform: translateX(-50%) translateY(6px); } to { opacity: 1; } }

/* 暗色适配：宿主暗色下文本 */
[data-hana-theme="dark"] .mrc-app,
[data-hana-theme="dark"] .mrc-panel {
  color-scheme: dark;
}
