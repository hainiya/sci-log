/**
 * 材料科研副驾 lifecycle（index.js）
 * - 会话绑定：订阅绑定会话的用户消息，节流触发文献自动搜集（autoCollectEnabled 控制）
 * - 目录 watch：文献目录变更自动入库（register() 清理全覆盖）
 * - 后台报告：文献库新增 ≥10 篇或距上次 ≥7 天自动更新分析报告
 * - 定时审查：24h 内无审查且当日有新实验记录时自动审查一次
 * - 隐私：autoCollectEnabled=false 时跳过会话监听逻辑，不触发不检索
 *
 * 宿主约定：本模块被宿主 new 实例化，ctx/register 通过属性注入，onload() 无参调用。
 */
import { createStore } from "./server/store.js";
import { createLiteratureClient } from "./server/literature-client.js";
import { extractKeywords, analyzeLiterature, reviewResearch } from "./server/llm.js";
import { readSettings, scanWorkspaceFolder, syncZotero } from "./server/sources.js";
import { createProposal } from "./server/proposals.js";

const AUTO_COLLECT_THROTTLE_MS = 10 * 60 * 1000; // 10 分钟节流
const REPORT_MIN_NEW = 10; // 新增 ≥10 篇触发报告
const REPORT_MAX_AGE_MS = 7 * 24 * 60 * 60 * 1000; // 距上次 ≥7 天
const AUTO_REVIEW_INTERVAL_MS = 24 * 60 * 60 * 1000; // 审查间隔 ≥24h

export default class MaterialsResearchCopilotPlugin {
  async onload() {
    const ctx = this.ctx;
    const register = this.register;
    this._store = createStore(ctx.dataDir);
    this._state = {
      binding: null,
      watch: null,
      lastAutoCollectAt: 0,
      lastAutoReviewAt: 0,
    };

    // ── 会话事件（用户消息 → 自动搜集） ──
    this._unsubSession = ctx.bus.subscribe(
      (event, sessionPath) => this._onSessionEvent(event, sessionPath),
      { types: ["session_user_message"] }
    );
    register(this._unsubSession);

    // ── 内部事件：绑定变化 → 重新加载 ──
    this._unsubBinding = ctx.bus.subscribe(
      () => this._reloadBinding(),
      { types: ["materials-research-copilot:binding-changed"] }
    );
    register(this._unsubBinding);

    // ── 资源事件（watch 目录变更） ──
    this._unsubResource = ctx.bus.subscribe(
      (event) => this._onResourceEvent(event),
      { types: ["resource.changed", "resource.deleted", "resource.renamed"] }
    );
    register(this._unsubResource);

    // ── 后台定时器（报告更新 / 定期审查 / Zotero 同步） ──
    this._reportTimer = setInterval(() => this._maybeAutoReport(), 30 * 60 * 1000);
    this._reportTimer.unref?.();
    register(() => clearInterval(this._reportTimer));

    this._reviewTimer = setInterval(() => this._maybeAutoReview(), 60 * 60 * 1000);
    this._reviewTimer.unref?.();
    register(() => clearInterval(this._reviewTimer));

    // Zotero 全量镜像同步：30 分钟间隔，异步不阻塞消息流
    this._zoteroTimer = setInterval(() => this._syncZoteroNow(), 30 * 60 * 1000);
    this._zoteroTimer.unref?.();
    register(() => clearInterval(this._zoteroTimer));

    // ── 初始化 ──
    this._reloadBinding();
    await this._setupWatch();
    this._syncZoteroNow().catch(() => {}); // 启动后立即同步一次（失败静默，定时器会重试）

    ctx.log.info("materials-research-copilot lifecycle loaded");
  }

  async _syncZoteroNow() {
    const ctx = this.ctx;
    try {
      const result = await syncZotero(ctx, this._store);
      if (result.ok) {
        ctx.log.info(`zotero sync: ${result.replaced} entries mirrored`);
      } else {
        ctx.log.info(`zotero sync skipped: ${result.code || result.error}`);
      }
    } catch (err) {
      ctx.log.warn("zotero sync failed:", err.message);
    }
  }

  async onunload() {
    this._teardownWatch();
    this._state.binding = null;
  }

  // ── 会话绑定 ──────────────────────────────────────────────

  _reloadBinding() {
    try {
      this._state.binding = this._store.read("binding");
    } catch {
      this._state.binding = null;
    }
  }

  _boundSessionPath() {
    return this._state.binding?.sessionPath || null;
  }

  // ── 会话事件：用户消息 → 节流自动搜集 ────────────────────

  async _onSessionEvent(event, sessionPath) {
    const ctx = this.ctx;
    const boundPath = this._boundSessionPath();
    if (!boundPath || !sessionPath || sessionPath !== boundPath) return;

    const autoCollect = ctx.config.get?.("autoCollectEnabled") ?? true;
    if (!autoCollect) return;

    const now = Date.now();
    if (now - this._state.lastAutoCollectAt < AUTO_COLLECT_THROTTLE_MS) return;
    this._state.lastAutoCollectAt = now;

    const text = String(event?.message?.text || "").trim();
    if (!text || text.length < 20) return;

    // 异步执行，不阻塞消息流
    this._autoCollect(text).catch((err) => {
      ctx.log.warn("auto collect failed:", err.message);
    });
  }

  async _autoCollect(text) {
    const ctx = this.ctx;
    const store = this._store;
    const keywords = await extractKeywords(ctx, text.slice(0, 2000));
    if (!keywords || keywords.length === 0) return;

    const query = keywords.join(" ");
    const client = createLiteratureClient(ctx);
    const items = await client.searchAll(query, 6);
    if (items.length === 0) return;

    const entries = items.map((item, i) => ({
      id: `lit_auto_${Date.now().toString(36)}_${i}`,
      addedAt: store.now(),
      status: "new",
      autoCollected: true,
      ...item,
    }));

    const autoApprove = ctx.config.get?.("autoApproveLiterature") ?? true;
    let applied = 0;
    if (autoApprove) {
      applied = store.append("literature", entries).appended;
    } else {
      for (const entry of entries) {
        createProposal(store, {
          target: "literature",
          action: "create",
          diff: entry,
          reason: `自动搜集（研究方向）：${entry.title}`,
        });
      }
    }

    ctx.log.info(`auto collect: ${keywords.join("/")} → ${applied} entries`);
  }

  // ── 文献目录 watch ────────────────────────────────────────

  async _setupWatch() {
    const ctx = this.ctx;
    this._teardownWatch();
    let folders;
    try {
      folders = (readSettings(ctx, this._store).literatureFolders || []).filter((f) => f.ref);
    } catch {
      folders = [];
    }
    if (folders.length === 0) return;

    const refs = folders.map((f) => f.ref);
    try {
      const handle = ctx.resources.subscribe(refs, {
        purpose: "plugin:materials-research-copilot:literature-folders",
      });
      this._state.watch = handle;
      if (handle?.unsubscribe) {
        this.register(() => handle.unsubscribe());
      }
    } catch (err) {
      ctx.log.warn("literature folder watch failed:", err.message);
    }
  }

  _teardownWatch() {
    const handle = this._state.watch;
    if (handle?.unsubscribe) {
      try {
        handle.unsubscribe();
      } catch {}
    }
    this._state.watch = null;
  }

  async _onResourceEvent(event) {
    const handle = this._state.watch;
    if (!handle) return;
    const keys = handle.resourceKeys || [];
    const eventKey = String(event?.resourceKey || "");
    if (!eventKey) return;
    const matches = keys.some((key) => eventKey.startsWith(key) || key.startsWith(eventKey));
    if (!matches) return;

    // 找到对应目录重新扫描入库
    const ctx = this.ctx;
    const folders = (readSettings(ctx, this._store).literatureFolders || []).filter((f) => f.ref);
    const entryPromises = folders.map(async (folder) => {
      const found = await scanWorkspaceFolder(ctx, folder.ref);
      const records = found
        .filter((item) => !item.error && !item.unsupported && (item.record || item.pdf))
        .map((item, i) => ({
          id: `lit_watch_${Date.now().toString(36)}_${i}`,
          addedAt: this._store.now(),
          status: "new",
          watchCollected: true,
          ...(item.record || {
            title: item.meta?.title,
            year: item.meta?.year,
            authors: [],
            venue: "",
            doi: null,
            url: null,
            abstract: "",
            keywords: [],
          }),
          source: "workspace",
          sourceApi: "workspace",
          fileName: item.name,
          ref: item.ref,
        }));
      if (records.length > 0) {
        this._store.append("literature", records);
      }
    });
    try {
      await Promise.all(entryPromises);
    } catch (err) {
      ctx.log.warn("watch rescan failed:", err.message);
    }
  }

  // ── 后台报告更新 ──────────────────────────────────────────

  async _maybeAutoReport() {
    const ctx = this.ctx;
    const store = this._store;
    try {
      const literature = store.read("literature");
      const report = store.read("report");
      const lastVersion = report.basedOnLiteratureVersion ?? 0;
      const lastUpdated = report.updatedAt ? Date.parse(report.updatedAt) : 0;
      const newCount = literature.version - lastVersion;
      const tooOld = lastUpdated > 0 && Date.now() - lastUpdated > REPORT_MAX_AGE_MS;
      if (newCount < REPORT_MIN_NEW && !tooOld) return;
      if (literature.entries?.length === 0) return;

      // A2：Zotero 与在线/工作区条目共同进分析（不再排除）；
      // 无摘要/无 DOI 的条目由 prompt 侧标注「待补全」
      const forAnalysis = {
        ...literature,
        entries: literature.entries || [],
      };
      if (forAnalysis.entries.length === 0) return;

      const content = await analyzeLiterature(ctx, forAnalysis, store.read("plan"));
      store.write("report", {
        version: 0,
        content,
        updatedAt: store.now(),
        basedOnLiteratureVersion: literature.version,
      });
      store.bump("report");
      ctx.log.info("auto report updated");
    } catch (err) {
      ctx.log.warn("auto report failed:", err.message);
    }
  }

  // ── 定期审查（当日有新记录才触发） ────────────────────────

  async _maybeAutoReview() {
    const ctx = this.ctx;
    const store = this._store;
    try {
      const now = Date.now();
      if (now - this._state.lastAutoReviewAt < AUTO_REVIEW_INTERVAL_MS) return;

      const worklog = store.read("worklog");
      const entries = worklog.entries || [];
      const lastEntry = entries.at(-1);
      if (!lastEntry?.createdAt) return;
      if (now - Date.parse(lastEntry.createdAt) > 24 * 60 * 60 * 1000) return;

      this._state.lastAutoReviewAt = now;
      const rawReport = await reviewResearch(ctx, {
        plan: store.read("plan"),
        worklog,
        gantt: store.read("gantt"),
        literature: store.read("literature"),
        rejected: store.read("rejected"),
        target: "research",
      });

      const { report, suggestions } = splitSuggestions(rawReport);
      const reviewEntry = {
        id: `rev_auto_${Date.now().toString(36)}`,
        date: store.now(),
        target: "research",
        report,
        auto: true,
        createdAt: store.now(),
      };
      store.update("reviews", undefined, (current) => ({
        entries: [...(current.entries || []), reviewEntry],
      }));

      for (const suggestion of suggestions) {
        try {
          const baseVersion = store.read(suggestion.target).version;
          createProposal(store, {
            target: suggestion.target,
            action: suggestion.action,
            diff: suggestion.diff,
            reason: `自动审查建议：${suggestion.reason || "依据审查报告"}`,
            baseVersion,
          });
        } catch {}
      }
      ctx.log.info("auto review completed");
    } catch (err) {
      ctx.log.warn("auto review failed:", err.message);
    }
  }
}

function splitSuggestions(rawReport) {
  const marker = "<!--SUGGESTIONS-->";
  const idx = rawReport.indexOf(marker);
  if (idx === -1) return { report: String(rawReport || "").trim(), suggestions: [] };
  const report = rawReport.slice(0, idx).trim();
  const raw = rawReport.slice(idx + marker.length).trim();
  try {
    const jsonMatch = raw.match(/\{[\s\S]*\}/);
    const parsed = jsonMatch ? JSON.parse(jsonMatch[0]) : null;
    const suggestions = Array.isArray(parsed?.suggestions) ? parsed.suggestions : [];
    return {
      report,
      suggestions: suggestions
        .filter(
          (s) =>
            s &&
            ["plan", "gantt", "calendar", "worklog", "literature"].includes(s.target) &&
            ["create", "update", "delete"].includes(s.action) &&
            s.diff
        )
        .slice(0, 8),
    };
  } catch {
    return { report, suggestions: [] };
  }
}
