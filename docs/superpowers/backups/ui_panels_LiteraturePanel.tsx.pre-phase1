import { useEffect, useMemo, useState } from 'react';
import { api, hana } from '../api';

type Props = {
  state: any;
  onStateChange: () => Promise<void>;
  showToast: (msg: string) => void;
};

const SOURCE_LABELS: Record<string, string> = {
  online: '在线检索',
  workspace: '工作区',
  zotero: 'Zotero',
};

export function LiteraturePanel({ state, onStateChange, showToast }: Props) {
  const [filter, setFilter] = useState<string>('all');
  const [reportBusy, setReportBusy] = useState(false);
  const [zotero, setZotero] = useState<any>(null);

  const entries: any[] = state?.literature?.entries || [];
  const report = state?.report?.content || '';
  const reportUpdatedAt = state?.report?.updatedAt || null;

  useEffect(() => {
    api.zoteroStatus().then(setZotero).catch(() => setZotero({ ok: false, error: 'unavailable' }));
  }, []);

  const filtered = useMemo(() => {
    if (filter === 'all') return entries;
    return entries.filter((e) => e.source === filter);
  }, [entries, filter]);

  const sourceCounts = useMemo(() => {
    const counts: Record<string, number> = {};
    for (const e of entries) counts[e.source || 'unknown'] = (counts[e.source || 'unknown'] || 0) + 1;
    return counts;
  }, [entries]);

  const refreshReport = async () => {
    setReportBusy(true);
    try {
      await api.refreshReport();
      await onStateChange();
      showToast('分析报告已更新');
    } catch (err: any) {
      showToast(`报告生成失败：${err.message}`);
    } finally {
      setReportBusy(false);
    }
  };

  const copyRis = async (entry: any) => {
    try {
      const key = entry.zoteroKey || entry.id;
      const r = await api.exportItemRis(key);
      await hana.clipboard.writeText(r.ris);
      showToast('RIS 已复制到剪贴板');
    } catch (err: any) {
      showToast(`导出失败：${err.message}`);
    }
  };

  return (
    <div className="mrc-panel-section">
      <div className="mrc-section-head">
        <span className="mrc-section-title">📚 文献库</span>
        <span className="mrc-count">{entries.length}</span>
        <span className="mrc-zotero-status" title={zotero?.ok ? `Zotero 已连接：${zotero.total} 条` : `Zotero 未连接${zotero?.error ? `：${zotero.error}` : ''}`}>
          {zotero?.ok ? '● Zotero 在线' : '○ Zotero 离线'}
        </span>
      </div>

      <div className="mrc-filter-row">
        {['all', 'online', 'zotero'].map((key) => (
          <button
            key={key}
            className={`mrc-chip ${filter === key ? 'active' : ''}`}
            onClick={() => setFilter(key)}
          >
            {key === 'all' ? '全部' : SOURCE_LABELS[key] || key}
            {key !== 'all' && sourceCounts[key] ? ` (${sourceCounts[key]})` : ''}
          </button>
        ))}
      </div>

      <div className="mrc-literature-list">
        {filtered.length === 0 && <div className="mrc-empty">文献库为空。点击右上角「🔄 扫描文献」或让助手用 collect_literature 搜集。</div>}
        {filtered.slice(-100).reverse().map((entry) => (
          <article key={entry.id || entry.title} className="mrc-paper-card">
            <div className="mrc-paper-title">{entry.title || '（未命名文献）'}</div>
            <div className="mrc-paper-meta">
              {entry.year ? <span className="mrc-paper-year">{entry.year}</span> : null}
              {entry.venue ? <span className="mrc-paper-venue">{entry.venue}</span> : null}
              <span className={`mrc-paper-source src-${entry.source || 'unknown'}`}>
                {entry.source === 'zotero' ? (entry.readOnly ? 'Zotero 镜像' : 'Zotero') : SOURCE_LABELS[entry.source] || entry.source}
                {entry.unsupported ? '（暂不支持解析）' : ''}
              </span>
              {entry.citationCount != null && <span className="mrc-paper-cites">引用 {entry.citationCount}</span>}
              {entry.readOnly && (
                <button className="mrc-btn small" title="复制单条 RIS（Zotero 中已有，可直接导入其他工具）" onClick={() => copyRis(entry)}>复制 RIS</button>
              )}
            </div>
            {entry.authors?.length > 0 && (
              <div className="mrc-paper-authors">{entry.authors.slice(0, 6).join(', ')}{entry.authors.length > 6 ? ' et al.' : ''}</div>
            )}
            {entry.abstract ? <p className="mrc-paper-abstract">{String(entry.abstract).slice(0, 200)}{entry.abstract.length > 200 ? '…' : ''}</p> : null}
            {(entry.doi || entry.url) && (
              <div className="mrc-paper-links">
                {entry.doi ? <span className="mrc-paper-doi">DOI: {entry.doi}</span> : null}
                {entry.url ? <a href="#" onClick={(e) => { e.preventDefault(); window.open(entry.url, '_blank'); }}>链接 ↗</a> : null}
              </div>
            )}
          </article>
        ))}
      </div>

      <div className="mrc-report-block">
        <div className="mrc-section-head">
          <span className="mrc-section-title">📑 文献分析报告</span>
          <button className="mrc-btn small" onClick={refreshReport} disabled={reportBusy}>
            {reportBusy ? '生成中…' : '🔄 更新报告'}
          </button>
        </div>
        {reportUpdatedAt && <div className="mrc-report-time">更新于 {new Date(reportUpdatedAt).toLocaleString('zh-CN')}</div>}
        {report ? (
          <div className="mrc-report-body">{report.split('\n').map((line: string, i: number) => (
            <div key={i}>{line || '\u00A0'}</div>
          ))}</div>
        ) : (
          <div className="mrc-empty">报告未生成。点击「🔄 更新报告」生成（文献分析基于文献库全部条目，含 Zotero 镜像）。</div>
        )}
      </div>
    </div>
  );
}
