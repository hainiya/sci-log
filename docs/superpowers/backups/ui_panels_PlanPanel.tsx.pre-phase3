import { useMemo, useState } from 'react';
import { api } from '../api';
import { ProposalsPanel } from './ProposalsPanel';

type Props = {
  state: any;
  onStateChange: () => Promise<void>;
  showToast: (msg: string) => void;
};

type Tab = 'plan' | 'worklog' | 'proposals';

export function PlanPanel({ state, onStateChange, showToast }: Props) {
  const [tab, setTab] = useState<Tab>('plan');

  const pendingCount = useMemo(
    () => (state?.proposals?.entries || []).filter((p: any) => p.status === 'pending').length,
    [state]
  );

  return (
    <div className="mrc-panel-section">
      <div className="mrc-tabs">
        <button className={`mrc-tab ${tab === 'plan' ? 'active' : ''}`} onClick={() => setTab('plan')}>研究方案</button>
        <button className={`mrc-tab ${tab === 'worklog' ? 'active' : ''}`} onClick={() => setTab('worklog')}>实验记录</button>
        <button className={`mrc-tab mrc-tab-proposals ${tab === 'proposals' ? 'active' : ''} ${pendingCount > 0 ? 'has-badge' : ''}`} onClick={() => setTab('proposals')}>
          提案确认{pendingCount > 0 ? ` (${pendingCount})` : ''}
        </button>
      </div>

      {tab === 'plan' && <PlanEditor state={state} onStateChange={onStateChange} showToast={showToast} />}
      {tab === 'worklog' && <WorklogView state={state} onStateChange={onStateChange} showToast={showToast} />}
      {tab === 'proposals' && <ProposalsPanel state={state} onStateChange={onStateChange} showToast={showToast} />}
    </div>
  );
}

function PlanEditor({ state, onStateChange, showToast }: Props) {
  const plan = state?.plan || {};
  const [draft, setDraft] = useState<{ title: string; hypothesis: string; route: string; milestones: string }>({
    title: plan.title || '',
    hypothesis: plan.hypothesis || '',
    route: plan.route || '',
    milestones: Array.isArray(plan.milestones) ? plan.milestones.join('\n') : '',
  });
  const [saving, setSaving] = useState(false);
  const [guide, setGuide] = useState({ background: '', problem: '', data: '' });
  const [guiding, setGuiding] = useState(false);

  // C1：方案为空时显示引导卡
  const isEmptyPlan = !String(plan.title || '').trim() && !String(plan.hypothesis || '').trim();

  const generateDraft = async () => {
    setGuiding(true);
    try {
      const r = await api.proposalDraft(guide);
      setDraft({
        title: r.draft.title,
        hypothesis: r.draft.hypothesis || '',
        route: r.draft.route || '',
        milestones: (r.draft.milestones || []).join('\n'),
      });
      await onStateChange();
      showToast(r.applied ? '草案已直接生效' : `草案已生成，提案 ${r.proposalId || ''} 待确认（在「提案确认」中接受后生效）`);
    } catch (err: any) {
      showToast(`草案生成失败：${err.message}`);
    } finally {
      setGuiding(false);
    }
  };

  const save = async () => {
    setSaving(true);
    try {
      const data = {
        title: draft.title,
        hypothesis: draft.hypothesis,
        route: draft.route,
        milestones: draft.milestones.split('\n').map((m) => m.trim()).filter(Boolean),
      };
      await api.write('plan', plan.version, data);
      await onStateChange();
      showToast('方案已保存');
    } catch (err: any) {
      showToast(err.message.includes('version_conflict') ? '数据已被更新，已为你刷新，请重新编辑' : `保存失败：${err.message}`);
      onStateChange();
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="mrc-plan-editor">
      {isEmptyPlan && (
        <div className="mrc-guide-card">
          <div className="mrc-section-head">
            <span className="mrc-section-title">🚀 建立研究方案</span>
          </div>
          <p className="mrc-drawer-hint">方案是分析/建议/审查的共同输入。填几个问题，AI 帮你生成草案（走提案确认）。</p>
          <div className="mrc-field">
            <label>课题背景</label>
            <textarea rows={2} value={guide.background} onChange={(e) => setGuide({ ...guide, background: e.target.value })} placeholder="例如：SnSe 基热电材料晶格热导率与载流子输运的协同优化…" />
          </div>
          <div className="mrc-field">
            <label>要解决的问题</label>
            <textarea rows={2} value={guide.problem} onChange={(e) => setGuide({ ...guide, problem: e.target.value })} placeholder="例如：目前 ZT 值受限于…，需要解决…" />
          </div>
          <div className="mrc-field">
            <label>手头数据 / 已有条件（可选）</label>
            <textarea rows={2} value={guide.data} onChange={(e) => setGuide({ ...guide, data: e.target.value })} placeholder="例如：已有区熔炉、文献库 52 篇热电文献…" />
          </div>
          <button className="mrc-btn primary" onClick={generateDraft} disabled={guiding || (!guide.background.trim() && !guide.problem.trim())}>
            {guiding ? '生成中…' : '✨ 生成方案草案'}
          </button>
        </div>
      )}
      <div className="mrc-field">
        <label>研究题目</label>
        <input value={draft.title} onChange={(e) => setDraft({ ...draft, title: e.target.value })} placeholder="例如：高效稳定钙钛矿太阳能电池的界面工程研究" />
      </div>
      <div className="mrc-field">
        <label>研究假设</label>
        <textarea rows={3} value={draft.hypothesis} onChange={(e) => setDraft({ ...draft, hypothesis: e.target.value })} placeholder="提出你的科学假设…" />
      </div>
      <div className="mrc-field">
        <label>技术路线</label>
        <textarea rows={5} value={draft.route} onChange={(e) => setDraft({ ...draft, route: e.target.value })} placeholder="实验/计算/表征路线，每行一步…" />
      </div>
      <div className="mrc-field">
        <label>里程碑（每行一个）</label>
        <textarea rows={3} value={draft.milestones} onChange={(e) => setDraft({ ...draft, milestones: e.target.value })} placeholder="M1: 文献调研完成&#10;M2: 器件制备工艺稳定…" />
      </div>
      <div className="mrc-actions">
        <button className="mrc-btn primary" onClick={save} disabled={saving}>{saving ? '保存中…' : '保存方案'}</button>
        <button className="mrc-btn" onClick={() => api.rollback('plan').then(async (r) => { await onStateChange(); showToast('已回退到上一版本'); }).catch((e) => showToast(e.message))}>↩ 回退上一版</button>
      </div>
      <div className="mrc-hint">保存直接落库（面板人工编辑不经过提案）；AI 修改方案会走提案确认。</div>
    </div>
  );
}

function WorklogView({ state, onStateChange, showToast }: Props) {
  const entries: any[] = state?.worklog?.entries || [];
  const ganttTasks: any[] = state?.gantt?.tasks || [];
  const [content, setContent] = useState('');
  const [data, setData] = useState('');
  const [taskId, setTaskId] = useState('');
  const [progress, setProgress] = useState('');
  const [saving, setSaving] = useState(false);

  const save = async () => {
    if (!content.trim()) return;
    setSaving(true);
    try {
      await api.write('worklog', state.worklog.version, {
        entries: [
          ...entries,
          {
            id: `work_${Date.now().toString(36)}`,
            date: new Date().toISOString().slice(0, 10),
            content: content.trim(),
            data: data.trim() || null,
            taskId: taskId || null,
            createdAt: new Date().toISOString(),
          },
        ],
      });
      if (taskId && progress !== '') {
        await api.write('gantt', state.gantt.version, {
          tasks: ganttTasks.map((t) => (t.id === taskId ? { ...t, progress: Math.min(100, Math.max(0, Number(progress) || 0)) } : t)),
        });
      }
      setContent(''); setData(''); setProgress('');
      await onStateChange();
      showToast('实验记录已保存');
    } catch (err: any) {
      showToast(err.message.includes('version_conflict') ? '数据已被更新，已为你刷新' : `保存失败：${err.message}`);
      onStateChange();
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="mrc-worklog">
      <div className="mrc-field">
        <label>今天做了什么？（写入实验记录）</label>
        <textarea rows={3} value={content} onChange={(e) => setContent(e.target.value)} placeholder="例如：合成了 CsPbI3 薄膜，退火 150°C 后 PL 强度提升…" />
      </div>
      <div className="mrc-field">
        <label>实验数据（可选）</label>
        <textarea rows={2} value={data} onChange={(e) => setData(e.target.value)} placeholder="关键数据/参数…" />
      </div>
      <div className="mrc-field-row">
        <select value={taskId} onChange={(e) => setTaskId(e.target.value)}>
          <option value="">关联任务（可选）</option>
          {ganttTasks.map((t) => <option key={t.id} value={t.id}>{t.name}</option>)}
        </select>
        {taskId && (
          <input type="number" min={0} max={100} placeholder="任务进度 %" value={progress} onChange={(e) => setProgress(e.target.value)} />
        )}
      </div>
      <button className="mrc-btn primary" onClick={save} disabled={saving || !content.trim()}>{saving ? '保存中…' : '记录本次工作'}</button>

      <div className="mrc-list">
        {entries.length === 0 && <div className="mrc-empty">还没有实验记录。记录工作后，可让助手审查研究进展。</div>}
        {[...entries].reverse().slice(0, 30).map((entry) => (
          <article key={entry.id} className="mrc-log-entry">
            <div className="mrc-log-head">
              <span className="mrc-log-date">{entry.date}</span>
              {entry.taskId && <span className="mrc-log-task">#{entry.taskId}</span>}
            </div>
            <div className="mrc-log-content">{entry.content}</div>
            {entry.fields && Object.keys(entry.fields).length > 0 && (
              <div className="mrc-log-fields">
                {Object.entries(entry.fields).map(([k, v]) => (
                  <span key={k} className="mrc-log-field">{k}: <b>{String(v)}</b></span>
                ))}
              </div>
            )}
            {entry.citations && entry.citations.length > 0 && (
              <div className="mrc-log-citations">📎 关联文献：{entry.citations.join('、')}</div>
            )}
            {entry.data && <pre className="mrc-log-data">{entry.data}</pre>}
          </article>
        ))}
      </div>
    </div>
  );
}
