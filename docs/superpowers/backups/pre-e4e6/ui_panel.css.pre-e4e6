/* 材料科研副驾面板样式 v2 —— 跟随宿主主题（CSS 变量优先） */
.mrc-panel {
  --mrc-accent: var(--hana-accent, #e08a3c);
  --mrc-accent-soft: var(--hana-accent-soft, rgba(224, 138, 60, 0.18));
  --mrc-bg: var(--hana-bg, transparent);
  --mrc-bg-card: var(--hana-bg-card, rgba(128, 128, 128, 0.06));
  --mrc-bg-solid: var(--hana-bg, #f8f5ed);
  --mrc-border: var(--hana-border, rgba(128, 128, 128, 0.25));
  --mrc-text: var(--hana-text, #2c2c2c);
  --mrc-text-dim: var(--hana-text-dim, #8a8a8a);
  --mrc-danger: #d64541;
  --mrc-ok: #2e9e5b;
}

.mrc-app {
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 13px;
  color: var(--mrc-text);
  background: var(--mrc-bg);
  min-height: 100%;
}

/* 头部 */
.mrc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  border-bottom: 1px solid var(--mrc-border);
}
.mrc-header-title { display: flex; align-items: center; gap: 8px; font-weight: 600; }
.mrc-logo { font-size: 18px; }
.mrc-binding { margin-left: 6px; }
.mrc-badge { font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 400; }
.mrc-badge.ok { background: rgba(46, 158, 91, 0.15); color: var(--mrc-ok); }
.mrc-badge.warn { background: rgba(224, 138, 60, 0.18); color: var(--mrc-accent); }
.mrc-header-actions { display: flex; gap: 6px; }

/* 按钮与输入 */
.mrc-btn {
  border: 1px solid var(--mrc-border);
  background: var(--mrc-bg-card);
  color: var(--mrc-text);
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 12px;
  cursor: pointer;
  transition: opacity 0.15s;
}
.mrc-btn:hover { opacity: 0.85; }
.mrc-btn:disabled { opacity: 0.45; cursor: not-allowed; }
.mrc-btn.primary { background: var(--mrc-accent); border-color: var(--mrc-accent); color: #fff; }
.mrc-btn.danger { color: var(--mrc-danger); border-color: rgba(214, 69, 65, 0.5); }
.mrc-btn.small { padding: 2px 8px; font-size: 11px; }
/* 两步确认按钮的待确认态 */
.mrc-btn-armed {
  background: var(--mrc-danger) !important;
  border-color: var(--mrc-danger) !important;
  color: #fff !important;
  font-weight: 700;
}

.mrc-app input, .mrc-app textarea, .mrc-app select {
  border: 1px solid var(--mrc-border);
  background: var(--mrc-bg-card);
  color: var(--mrc-text);
  border-radius: 6px;
  padding: 5px 8px;
  font-size: 12px;
  font-family: inherit;
  width: 100%;
  box-sizing: border-box;
}
.mrc-app textarea { resize: vertical; }

.mrc-link-btn {
  border: none; background: none; cursor: pointer;
  color: var(--mrc-accent); font-size: 11px; padding: 0 2px;
}
.mrc-link-btn:hover { text-decoration: underline; }

/* ===== 今日概览仪表盘 ===== */
.mrc-dashboard {
  display: grid;
  grid-template-columns: 1.3fr 1.3fr 0.7fr 1fr;
  gap: 10px;
  padding: 0 10px;
}
.mrc-dash-card {
  background: var(--mrc-bg-card);
  border: 1px solid var(--mrc-border);
  border-radius: 10px;
  padding: 8px 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
  text-align: left;
  font: inherit;
  color: var(--mrc-text);
}
button.mrc-dash-card { cursor: pointer; }
button.mrc-dash-card:hover { border-color: var(--mrc-accent); }
.mrc-dash-title { font-weight: 600; font-size: 12px; display: flex; align-items: center; gap: 6px; }
.mrc-dash-empty { font-size: 11px; color: var(--mrc-text-dim); }
.mrc-dash-task { display: flex; align-items: center; gap: 6px; font-size: 12px; }
.mrc-dash-task input[type="checkbox"] { width: auto; flex: 0 0 auto; }
.mrc-dash-task-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mrc-dash-task-progress { font-size: 11px; color: var(--mrc-accent); }
.mrc-dash-more { border: none; background: none; color: var(--mrc-accent); font-size: 11px; cursor: pointer; padding: 0; text-align: left; }
.mrc-dash-line { display: flex; align-items: center; gap: 6px; font-size: 12px; }
.mrc-dash-line-text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mrc-due-badge {
  flex: 0 0 auto; font-size: 10px; padding: 1px 6px; border-radius: 8px;
  background: var(--mrc-accent-soft); color: var(--mrc-accent);
}
.mrc-due-badge.urgent { background: rgba(214, 69, 65, 0.15); color: var(--mrc-danger); font-weight: 700; }
.mrc-due-badge.event { background: rgba(78, 121, 167, 0.15); color: #4e79a7; }
.mrc-dash-proposals { align-items: center; justify-content: center; gap: 0; }
.mrc-dash-num { font-size: 24px; font-weight: 700; color: var(--mrc-text-dim); line-height: 1.1; }
.mrc-dash-proposals.has-pending .mrc-dash-num { color: var(--mrc-danger); }
.mrc-dash-label { font-size: 11px; color: var(--mrc-text-dim); }
.mrc-dash-cta { font-size: 11px; color: var(--mrc-accent); margin-top: 2px; }
.mrc-dash-week-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
.mrc-dash-week-grid > div { text-align: center; }
.mrc-dash-week-grid b { display: block; font-size: 15px; color: var(--mrc-accent); }
.mrc-dash-week-grid span { font-size: 10px; color: var(--mrc-text-dim); }

/* ===== 一级标签页 ===== */
.mrc-main-tabs {
  display: flex;
  gap: 4px;
  padding: 0 10px;
  border-bottom: 1px solid var(--mrc-border);
}
.mrc-main-tab {
  border: none; background: transparent; color: var(--mrc-text-dim);
  padding: 7px 14px; font-size: 13px; cursor: pointer;
  border-bottom: 2px solid transparent;
  display: flex; align-items: center; gap: 6px;
}
.mrc-main-tab.active { color: var(--mrc-accent); font-weight: 600; border-bottom-color: var(--mrc-accent); }
.mrc-main-tab.has-badge { color: var(--mrc-danger); font-weight: 600; }
.mrc-tab-badge {
  background: var(--mrc-danger); color: #fff;
  border-radius: 9px; padding: 0 6px; font-size: 10px; line-height: 16px;
}

.mrc-main { padding: 4px 10px 10px; min-width: 0; }

/* widget 窄条模式 */
.mrc-widget { padding: 0 10px 10px; display: flex; flex-direction: column; gap: 8px; }
.mrc-widget .mrc-dashboard { grid-template-columns: 1fr 1fr; padding: 0; }
.mrc-widget .mrc-dash-week { display: none; }

/* 通用区块卡片 */
.mrc-panel-section {
  background: var(--mrc-bg-card);
  border: 1px solid var(--mrc-border);
  border-radius: 10px;
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  overflow: hidden;
  min-width: 0;
}

/* 区块头 */
.mrc-section-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.mrc-section-title { font-weight: 600; font-size: 13px; }
.mrc-count { background: var(--mrc-accent-soft); color: var(--mrc-accent); border-radius: 10px; padding: 1px 8px; font-size: 11px; }
.mrc-zotero-status { margin-left: auto; font-size: 11px; color: var(--mrc-text-dim); }
.mrc-head-actions { margin-left: auto; display: flex; gap: 4px; }

/* 筛选 chips */
.mrc-filter-row { display: flex; gap: 4px; flex-wrap: wrap; }
.mrc-chip {
  border: 1px solid var(--mrc-border);
  background: transparent;
  color: var(--mrc-text);
  border-radius: 12px;
  padding: 2px 10px;
  font-size: 11px;
  cursor: pointer;
}
.mrc-chip.active { background: var(--mrc-accent); border-color: var(--mrc-accent); color: #fff; }
.mrc-chip.mini { font-size: 10px; padding: 1px 7px; }
.mrc-chip.mini.target-plan { border-color: rgba(78, 121, 167, 0.5); color: #4e79a7; }
.mrc-chip.mini.target-gantt { border-color: rgba(224, 138, 60, 0.5); color: var(--mrc-accent); }
.mrc-chip.mini.target-worklog { border-color: rgba(46, 158, 91, 0.5); color: var(--mrc-ok); }
.mrc-chip.mini.target-literature { border-color: rgba(155, 93, 229, 0.5); color: #9b5de5; }

/* ===== 文献库 ===== */
.mrc-literature { display: flex; flex-direction: column; gap: 10px; }
.mrc-literature-list { display: flex; flex-direction: column; gap: 6px; max-height: 60vh; overflow-y: auto; }
.mrc-paper-card {
  border: 1px solid var(--mrc-border);
  border-radius: 8px;
  padding: 8px;
  background: var(--mrc-bg);
}
.mrc-paper-title { font-weight: 600; font-size: 12.5px; line-height: 1.35; }
.mrc-paper-meta { display: flex; gap: 8px; align-items: center; margin-top: 3px; font-size: 11px; color: var(--mrc-text-dim); flex-wrap: wrap; }
.mrc-paper-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; align-items: center; }
.mrc-paper-year { color: var(--mrc-accent); }
.mrc-paper-venue { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px; }
.mrc-paper-source { font-size: 10px; padding: 1px 6px; border-radius: 8px; }
.mrc-paper-source.src-online { background: rgba(78, 121, 167, 0.15); color: #4e79a7; }
.mrc-paper-source.src-workspace { background: rgba(46, 158, 91, 0.15); color: var(--mrc-ok); }
.mrc-paper-source.src-zotero { background: rgba(214, 69, 65, 0.12); color: var(--mrc-danger); }
.mrc-paper-cites { font-size: 10px; }
.mrc-paper-ft { padding: 1px 6px; border-radius: 8px; font-size: 10px; background: rgba(56,132,255,.12); color: var(--mrc-accent); }
.mrc-paper-ft.scan { background: rgba(255,160,40,.14); color: #b45309; }
.mrc-paper-ft.trans { background: rgba(139,92,246,.12); color: #7c3aed; }
.mrc-paper-ft.none { background: rgba(200,200,200,.15); color: var(--mrc-text-dim); }
.mrc-ai-badge { display: inline-block; margin-right: 5px; padding: 0 5px; border-radius: 6px; font-size: 10px; background: linear-gradient(135deg, rgba(139,92,246,.16), rgba(56,132,255,.14)); color: #7c3aed; }
.mrc-paper-abstract.none { color: #b45309; }
.mrc-paper-authors { font-size: 11px; color: var(--mrc-text-dim); margin-top: 2px; }
.mrc-paper-abstract { font-size: 11.5px; color: var(--mrc-text-dim); margin: 4px 0 0; line-height: 1.45; }
.mrc-paper-abstract.expanded { color: var(--mrc-text); }
.mrc-paper-doi { color: var(--mrc-text-dim); font-size: 11px; }
.mrc-paper-link { color: var(--mrc-accent); text-decoration: none; font-size: 11px; }

/* 文献检索工具栏 */
.mrc-lit-toolbar { display: flex; gap: 6px; }
.mrc-lit-search { flex: 1; }
.mrc-lit-year { width: auto; flex: 0 0 96px; }
.mrc-lit-sort { width: auto; flex: 0 0 110px; }

/* 材料性质速查（Materials Project） */
.mrc-mp-toggle {
  background: none; border: none; cursor: pointer; padding: 0;
  display: flex; justify-content: space-between; align-items: center; width: 100%;
  color: var(--mrc-text); font: inherit;
}
.mrc-mp-toggle:hover { opacity: 0.85; }
.mrc-mp-body { display: flex; flex-direction: column; gap: 6px; }
.mrc-mp-msg { font-size: 11.5px; color: var(--mrc-text-dim); line-height: 1.5; }
.mrc-mp-table { display: flex; flex-direction: column; border: 1px solid var(--mrc-border); border-radius: 6px; overflow: hidden; }
.mrc-mp-row { display: grid; grid-template-columns: 1.4fr 0.9fr 1.1fr 0.8fr; gap: 4px; padding: 4px 8px; font-size: 11px; border-bottom: 1px solid var(--mrc-border); }
.mrc-mp-row:last-child { border-bottom: none; }
.mrc-mp-head { font-weight: 600; color: var(--mrc-text-dim); background: var(--mrc-bg-card); }

/* 报告 */
.mrc-report-time { font-size: 11px; color: var(--mrc-text-dim); }
.mrc-report-body {
  font-size: 12px; line-height: 1.55;
  max-height: 50vh; overflow-y: auto;
  border: 1px solid var(--mrc-border);
  border-radius: 8px;
  padding: 10px;
  word-break: break-word;
}
.mrc-export-row { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; border-top: 1px dashed var(--mrc-border); padding-top: 6px; }
/* 报告放大阅读 */
.mrc-report-modal {
  width: min(860px, 94vw); max-height: 90vh;
  background: var(--mrc-bg-solid);
  border: 1px solid var(--mrc-border);
  border-radius: 12px;
  padding: 14px;
  display: flex; flex-direction: column; gap: 10px;
  margin: auto;
}
.mrc-report-modal-body { overflow-y: auto; font-size: 13px; line-height: 1.6; }

/* Tabs（区块内次级） */
.mrc-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--mrc-border); padding-bottom: 6px; }
.mrc-tab {
  border: none; background: transparent; color: var(--mrc-text-dim);
  padding: 5px 10px; border-radius: 6px; font-size: 12.5px; cursor: pointer;
}
.mrc-tab.active { background: var(--mrc-accent-soft); color: var(--mrc-accent); font-weight: 600; }

/* 方案编辑器 */
.mrc-plan-editor, .mrc-worklog { display: flex; flex-direction: column; gap: 10px; }
.mrc-field { display: flex; flex-direction: column; gap: 4px; }
.mrc-field label { font-size: 11.5px; color: var(--mrc-text-dim); }
.mrc-field-row { display: flex; gap: 6px; flex-wrap: wrap; }
.mrc-field-row input, .mrc-field-row select { width: auto; flex: 1; min-width: 120px; }
.mrc-actions { display: flex; gap: 6px; }
.mrc-hint { font-size: 11px; color: var(--mrc-text-dim); }
.mrc-guide-card { border: 1px dashed var(--mrc-accent); border-radius: 8px; padding: 10px; display: flex; flex-direction: column; gap: 8px; }

/* 实验记录 */
.mrc-worklog-search { width: auto; flex: 1; min-width: 160px; }
.mrc-list { display: flex; flex-direction: column; gap: 6px; max-height: 55vh; overflow-y: auto; }
.mrc-log-entry { border: 1px solid var(--mrc-border); border-radius: 8px; padding: 8px; }
.mrc-log-head { display: flex; gap: 8px; font-size: 11px; color: var(--mrc-text-dim); align-items: center; }
.mrc-log-date { color: var(--mrc-accent); }
.mrc-log-sample { color: var(--mrc-accent); }
.mrc-log-edited { font-size: 10px; border: 1px solid var(--mrc-border); border-radius: 8px; padding: 0 6px; }
.mrc-log-actions { margin-left: auto; display: flex; gap: 4px; }
.mrc-log-edit { display: flex; flex-direction: column; gap: 6px; }
.mrc-log-content { margin-top: 4px; font-size: 12.5px; line-height: 1.5; }
.mrc-log-fields { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 6px; font-size: 11px; color: var(--mrc-text-dim); }
.mrc-log-field b { color: var(--mrc-text); font-weight: 600; }
.mrc-log-citations { margin-top: 4px; font-size: 11px; color: var(--mrc-accent); }
.mrc-log-data {
  margin: 6px 0 0; padding: 6px; background: var(--mrc-bg);
  border-radius: 6px; font-size: 11px; white-space: pre-wrap;
  max-height: 140px; overflow-y: auto;
}
.mrc-template-row { display: flex; gap: 4px; align-items: center; flex-wrap: wrap; margin-top: 4px; }
.mrc-template-label { font-size: 11px; color: var(--mrc-text-dim); }
.mrc-worklog-actions { margin-top: 2px; }

/* 提案 */
.mrc-proposals { display: flex; flex-direction: column; gap: 8px; max-height: 65vh; overflow-y: auto; }
.mrc-proposal { border: 1px solid var(--mrc-border); border-radius: 8px; padding: 8px; }
.mrc-proposal-head { display: flex; gap: 6px; align-items: center; }
.mrc-proposal-id { font-size: 10px; color: var(--mrc-text-dim); margin-left: auto; }
.mrc-proposal-reason { font-size: 12px; margin-top: 6px; }
.mrc-batch-row { display: flex; gap: 6px; flex-wrap: wrap; }
.mrc-proposal-diff {
  background: var(--mrc-bg); border: 1px solid var(--mrc-border);
  border-radius: 6px; padding: 6px; font-size: 11.5px;
  max-height: 220px; overflow: auto;
}
.mrc-proposal-diff.is-create { border-left: 3px solid var(--mrc-ok, #2e9e5b); }
.mrc-proposal-diff.is-update { border-left: 3px solid var(--mrc-accent, #e08a3c); }
.mrc-diff-row { display: flex; gap: 8px; padding: 3px 0; border-bottom: 1px dashed var(--mrc-border); }
.mrc-diff-row:last-child { border-bottom: none; }
.mrc-diff-key { flex: 0 0 84px; color: var(--mrc-text-dim); }
.mrc-diff-val { flex: 1; word-break: break-word; white-space: pre-wrap; }
.mrc-diff-add { color: var(--mrc-ok, #2e9e5b); }
.mrc-diff-new { color: var(--mrc-accent, #e08a3c); }
.mrc-proposal-edit .mrc-field textarea { margin-bottom: 6px; }
.mrc-proposal-edit textarea { margin-bottom: 6px; }
.mrc-proposal-reject input { margin-bottom: 6px; }
.mrc-chip.mini.stale { border-color: rgba(214, 69, 65, 0.5); color: var(--mrc-danger); }

/* 悬浮提案提示 */
.mrc-proposal-float {
  position: fixed; bottom: 20px; right: 20px;
  background: var(--mrc-accent); color: #fff;
  padding: 8px 14px; border-radius: 18px; font-size: 12.5px;
  cursor: pointer; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  z-index: 60;
}
.mrc-proposal-float:hover { opacity: 0.92; }

/* ===== 日程（甘特 + 侧栏） ===== */
.mrc-schedule { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr); gap: 10px; align-items: start; }
.mrc-schedule-side { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.mrc-gantt-wrap { display: flex; flex-direction: column; gap: 6px; }
.mrc-gantt { display: flex; flex-direction: column; gap: 6px; }
.mrc-gantt-toolbar { display: flex; gap: 8px; align-items: center; }
.mrc-gantt-zoom { display: flex; gap: 4px; }
.mrc-gantt-toolbar .mrc-hint { margin-left: auto; }
.mrc-gantt-scroll { overflow-x: auto; }
.mrc-gantt-svg { display: block; }
.mrc-gantt-label { user-select: none; }
.mrc-gantt-edit {
  display: flex; gap: 6px; align-items: center; flex-wrap: wrap;
  border: 1px solid var(--mrc-border); border-radius: 8px; padding: 8px; margin-top: 6px;
}
.mrc-gantt-edit input, .mrc-gantt-edit select { width: auto; }

/* 里程碑↔甘特打通 */
.mrc-milestone-list { display: flex; flex-direction: column; gap: 4px; }
.mrc-milestone-row {
  display: flex; gap: 8px; align-items: center;
  border: 1px solid var(--mrc-border); border-radius: 6px; padding: 4px 8px; font-size: 12px;
}
.mrc-milestone-idx { font-weight: 700; color: var(--mrc-accent); }
.mrc-milestone-text { flex: 1; }

/* 任务清单 */
.mrc-tasklist { display: flex; flex-direction: column; gap: 6px; max-height: 300px; overflow-y: auto; }
.mrc-task-row {
  display: flex; gap: 8px; align-items: center;
  border: 1px solid var(--mrc-border); border-radius: 6px; padding: 5px 8px;
}
.mrc-task-row input[type="checkbox"] { width: auto; flex: 0 0 auto; }
.mrc-task-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mrc-task-name.done { text-decoration: line-through; color: var(--mrc-text-dim); }
.mrc-task-slider { flex: 0 0 90px; padding: 0; }
.mrc-task-date { font-size: 11px; color: var(--mrc-text-dim); white-space: nowrap; }
.mrc-task-progress { font-size: 11px; color: var(--mrc-accent); min-width: 34px; text-align: right; }

/* 日历 */
.mrc-calendar { display: flex; flex-direction: column; gap: 6px; }
.mrc-calendar-head { display: flex; gap: 6px; align-items: center; }
.mrc-calendar-title { flex: 1; text-align: center; font-weight: 600; font-size: 13px; }
.mrc-calendar-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); }
.mrc-cal-weekday { text-align: center; font-size: 11px; color: var(--mrc-text-dim); padding: 2px 0; }
.mrc-calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
.mrc-cal-cell {
  border: 1px solid var(--mrc-border); border-radius: 5px;
  min-height: 64px; padding: 2px; cursor: pointer; position: relative;
  background: var(--mrc-bg); overflow: hidden;
}
.mrc-cal-cell.adding { overflow: visible; z-index: 20; }
.mrc-cal-cell.muted { opacity: 0.4; }
.mrc-cal-cell.today { border-color: var(--mrc-accent); }
.mrc-cal-daynum { font-size: 10.5px; color: var(--mrc-text-dim); }
.mrc-cal-cell.today .mrc-cal-daynum { color: var(--mrc-accent); font-weight: 700; }
.mrc-cal-event {
  font-size: 10px; line-height: 1.3;
  background: var(--mrc-accent-soft); color: var(--mrc-text);
  border-radius: 3px; padding: 1px 3px; margin-top: 1px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  display: flex; justify-content: space-between; gap: 2px;
}
.mrc-cal-event.type-task { background: rgba(78, 121, 167, 0.2); }
.mrc-cal-del { border: none; background: transparent; color: var(--mrc-text-dim); cursor: pointer; padding: 0 2px; font-size: 10px; }
.mrc-cal-more { font-size: 9.5px; color: var(--mrc-text-dim); }
.mrc-cal-add { position: absolute; top: 0; left: 0; width: 220px; min-height: 0; background: var(--mrc-bg-solid, #fff); border: 1px solid var(--mrc-accent); border-radius: 8px; box-shadow: 0 6px 20px rgba(0,0,0,0.2); padding: 8px; z-index: 30; display: flex; flex-direction: column; gap: 6px; }
.mrc-cal-add-title { font-size: 11px; color: var(--mrc-text-dim); }
.mrc-cal-add-row { display: flex; gap: 4px; align-items: center; }
.mrc-cal-add-row input, .mrc-cal-add-row select { width: auto; flex: 1; font-size: 11px; padding: 3px 5px; }
.mrc-cal-add-actions { display: flex; gap: 6px; }

/* 空态与加载 */
.mrc-empty { color: var(--mrc-text-dim); font-size: 12px; padding: 12px 4px; text-align: center; }
.mrc-loading { padding: 40px; text-align: center; color: var(--mrc-text-dim); }
.mrc-error { padding: 10px; color: var(--mrc-danger); display: flex; gap: 8px; align-items: center; }

/* 设置抽屉 */
.mrc-drawer-mask {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.35);
  z-index: 50; display: flex; justify-content: flex-end;
}
.mrc-drawer {
  width: min(420px, 92vw); height: 100%;
  background: var(--mrc-bg-solid);
  border-left: 1px solid var(--mrc-border);
  padding: 14px; overflow-y: auto;
  display: flex; flex-direction: column; gap: 12px;
}
.mrc-drawer-head { display: flex; justify-content: space-between; align-items: center; font-weight: 600; }
.mrc-drawer-section { display: flex; flex-direction: column; gap: 8px; }
.mrc-drawer-section h4 { margin: 0; font-size: 13px; }
.mrc-drawer-hint { font-size: 11px; color: var(--mrc-text-dim); margin: 0; line-height: 1.5; }
.mrc-folder-row {
  display: flex; justify-content: space-between; align-items: center; gap: 8px;
  border: 1px solid var(--mrc-border); border-radius: 6px; padding: 6px 8px; font-size: 12px;
}
.mrc-zotero-error { color: var(--mrc-danger); }
.mrc-rejected-row { border: 1px solid var(--mrc-border); border-radius: 6px; padding: 6px 8px; }
.mrc-rejected-summary { font-size: 11.5px; }
.mrc-rejected-reason { font-size: 11px; color: var(--mrc-text-dim); margin-top: 2px; }

/* Toast */
.mrc-toast {
  position: fixed; bottom: 60px; left: 50%; transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.78); color: #fff;
  padding: 8px 16px; border-radius: 8px; font-size: 12.5px; z-index: 80;
  max-width: 70vw; animation: mrc-fadein 0.2s ease; cursor: pointer;
}
.mrc-toast.error { background: rgba(127, 29, 29, 0.95); }
@keyframes mrc-fadein { from { opacity: 0; transform: translateX(-50%) translateY(6px); } to { opacity: 1; } }

/* 报告 Markdown 渲染 */
.mrc-markdown { font-size: 12px; line-height: 1.55; }
.mrc-markdown .mrc-md-h1 { font-size: 15px; font-weight: 700; margin: 10px 0 4px; }
.mrc-markdown .mrc-md-h2 { font-size: 13.5px; font-weight: 700; margin: 9px 0 3px; color: var(--mrc-accent); }
.mrc-markdown .mrc-md-h3 { font-size: 12.5px; font-weight: 600; margin: 7px 0 2px; }
.mrc-markdown .mrc-md-p { margin: 3px 0; }
.mrc-markdown .mrc-md-code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  background: var(--mrc-bg); border: 1px solid var(--mrc-border); border-radius: 4px;
  padding: 0 4px; font-size: 11px;
}
.mrc-markdown ul, .mrc-markdown ol { margin: 3px 0; padding-left: 18px; }
.mrc-markdown li { margin: 2px 0; }
.mrc-markdown a { color: var(--mrc-accent); text-decoration: none; }
.mrc-markdown .mrc-md-quote {
  border-left: 3px solid var(--mrc-border); margin: 4px 0; padding: 2px 8px;
  color: var(--mrc-text-dim); font-style: italic;
}
.mrc-markdown .mrc-md-hr { border: none; border-top: 1px dashed var(--mrc-border); margin: 8px 0; }

/* 窄屏响应式 */
@media (max-width: 1100px) {
  .mrc-dashboard { grid-template-columns: 1fr 1fr; }
  .mrc-schedule { grid-template-columns: 1fr; }
}
@media (max-width: 760px) {
  .mrc-dashboard { grid-template-columns: 1fr; }
  .mrc-header { flex-wrap: wrap; }
  .mrc-literature-list { max-height: 300px; }
  .mrc-list, .mrc-tasklist { max-height: 220px; }
  .mrc-proposals { max-height: 300px; }
}

/* 暗色主题兜底：即使宿主未注入 --hana-* 变量，也保证可读 */
[data-hana-theme="dark"] .mrc-panel {
  --mrc-accent: #e8a35a;
  --mrc-accent-soft: rgba(232, 163, 90, 0.2);
  --mrc-bg: #1f1d1a;
  --mrc-bg-card: rgba(255, 255, 255, 0.06);
  --mrc-bg-solid: #26231f;
  --mrc-border: rgba(255, 255, 255, 0.16);
  --mrc-text: #f0ece6;
  --mrc-text-dim: #a39c92;
  color-scheme: dark;
}
[data-hana-theme="dark"] .mrc-app input,
[data-hana-theme="dark"] .mrc-app textarea,
[data-hana-theme="dark"] .mrc-app select {
  background: var(--mrc-bg);
  color: var(--mrc-text);
}
[data-hana-theme="dark"] .mrc-paper-card,
[data-hana-theme="dark"] .mrc-panel-section,
[data-hana-theme="dark"] .mrc-log-entry,
[data-hana-theme="dark"] .mrc-proposal,
[data-hana-theme="dark"] .mrc-task-row,
[data-hana-theme="dark"] .mrc-cal-cell,
[data-hana-theme="dark"] .mrc-dash-card {
  background: var(--mrc-bg);
}
[data-hana-theme="dark"] .mrc-report-body,
[data-hana-theme="dark"] .mrc-proposal-diff,
[data-hana-theme="dark"] .mrc-log-data { background: rgba(0, 0, 0, 0.25); }
