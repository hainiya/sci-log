{
  "manifestVersion": 2,
  "id": "sci-log",
  "name": "科研工作",
  "version": "2.0.0",
  "description": "科研工作台：实验记录 + 甘特图/日历 + 指标趋势 + 文献库。v2 App 形态。",
  "entry": "index.js",
  "capabilities": ["tools"],
  "network": {
    "allowedHosts": ["localhost", "127.0.0.1", "api.openalex.org"],
    "methods": ["GET", "POST"],
    "defaultTimeoutMs": 15000,
    "maxResponseBytes": 10485760,
    "allowLocalhost": true
  },
  "contributes": {
    "settings": {
      "title": "科研工作",
      "schema": {
        "type": "object",
        "properties": {
          "zoteroPort": {
            "type": "integer",
            "default": 23119,
            "title": "Zotero 本地 API 端口",
            "description": "Zotero 桌面客户端本地 API 监听端口（Zotero 7+，需保持客户端运行）"
          }
        }
      }
    },
    "cards": [
      {
        "id": "panel",
        "title": "科研工作",
        "route": "/panel.html"
      }
    ]
  }
}
